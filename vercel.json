{
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "framework": "vite"
      }
    },
    {
      "src": "server/package.json",
      "use": "@vercel/server"
      }
  ],
  "routes": [
    {
      "src": "/api/:path*",
      "dest": "/server/index.js"
    }
  ]
}